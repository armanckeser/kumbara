# Production env template for the Pi's api container (copy to server/.env, fill in, keep out of git).
# Only SECRETS and box-specific values live here; docker-compose.prod.yml sets the non-secret defaults.

# ---- SimpleFIN ----
# First-pull backfill window for the single-connection real-run path (the UI Connect flow sets its own).
# SIMPLEFIN_START_DATE=2024-01-01

# ---- Push notifications (optional; feature no-ops without both keys) ----
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@kumbara.app

# ---- Auth (OIDC BFF; Cosmos is the provider) ----
# Auth vars do NOT go here. They are declared in docker-compose.prod.yml's `environment` (with empty defaults)
# so you set the real values on the container env via the Cosmos UI, or a Pi-local `.env` next to the compose
# file: AUTH_ENABLED, OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_REDIRECT_URI, OIDC_AUTH_EXTERNAL_URL, OIDC_CLIENT_SECRET,
# OIDC_AUTH_SECRET, AGENT_API_TOKEN. See DEPLOY.md "Auth".
#
# Session duration (compose has working defaults; override only if login keeps dropping): OIDC_SCOPES must
# include `offline` (Cosmos's refresh-token scope, NOT offline_access) or the session dies every 15 min;
# OIDC_AUTH_REFRESH_INTERVAL / OIDC_AUTH_EXPIRES bound the refresh cadence / ceiling. See DEPLOY.md.
